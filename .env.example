# Redis (obrigatório) — monta a connection string do StackExchange.Redis
Redis__Host=localhost
Redis__Port=6379
Redis__Password=
Redis__User=
Redis__AbortConnect=false
# Redis__Ssl=false

# Alternativa: string pronta (só usada se Redis__Host estiver vazio)
# ConnectionStrings__Redis=

# JWT / seed (recomendado fora do appsettings em produção)
Jwt__Key=
Seed__AtendenteSenha=
